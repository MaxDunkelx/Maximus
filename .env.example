# Copy to .env and fill in locally. Never commit .env.

# Free local model. Requires the Ollama app and `ollama pull llama3.2`.
MAXIMUS_PROVIDER=ollama
MAXIMUS_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional paid Grok provider. Set MAXIMUS_PROVIDER=grok and fill this in to use it.
XAI_API_KEY=

# Optional provider settings.
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7
MAXIMUS_STORE_RESPONSES=false
MAXIMUS_REASONING_EFFORT=medium
MAXIMUS_MAX_OUTPUT_TOKENS=2048
MAXIMUS_REQUEST_TIMEOUT_MS=60000

# Local server. Stay on loopback unless MAXIMUS_API_TOKEN is set.
MAXIMUS_HOST=127.0.0.1
MAXIMUS_PORT=8787
MAXIMUS_API_TOKEN=
MAXIMUS_LOG_LEVEL=info

# Leave unset to keep the database out of OneDrive (Windows default: %LOCALAPPDATA%\Maximus).
# MAXIMUS_DATA_DIR=
